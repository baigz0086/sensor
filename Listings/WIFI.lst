 601          
 602          u8 fVerifyServerCammand(void)
 603          {
 604   1        u8 Command;
 605   1        u8 i;
 606   1        u16 CheckSum;
 607   1        
 608   1        Command = 0;
 609   1        CheckSum = 0;
 610   1        
 611   1        for(i = 0; i < (pUART2_rptr - 2); i++) CheckSum += UART2_buffer[i];         //sum data except last two data
 612   1        
C51 COMPILER V9.59.0.0   WIFI                                                              06/09/2025 08:02:58 PAGE 11  

 613   1        if(UART2_buffer[pUART2_rptr - 1] != (unsigned char)(CheckSum)) Command = 0; //check sum low byte
 614   1        else if(UART2_buffer[pUART2_rptr - 2] != (unsigned char)(CheckSum >> 8)) Command = 0; //check sum high by
             -te
 615   1        else if(UART2_buffer[0] != 'S' || UART2_buffer[1] != 'V') Command = 0;      //check frame head
 616   1        else if(UART2_buffer[2] != MacAddr[0]) Command = 0;                         //check ID
 617   1        else if(UART2_buffer[3] != MacAddr[1]) Command = 0;
 618   1        else if(UART2_buffer[4] != MacAddr[2]) Command = 0;
 619   1        else if(UART2_buffer[5] != MacAddr[3]) Command = 0;
 620   1        else if(UART2_buffer[6] != MacAddr[4]) Command = 0;
 621   1        else if(UART2_buffer[7] != MacAddr[5]) Command = 0;
 622   1        else if(UART2_buffer[8] != pUART2_rptr) Command = 0;                        //check frame length
 623   1        else Command = 1;
 624   1        
 625   1        Command = 1;
 626   1        
 627   1        return Command;
 628   1      }
