1380          
1381          unsigned char HexToAsc(unsigned char aChar)
1382          {
1383   1        if((aChar>=0x30)&&(aChar<=0x39))
1384   1        aChar -= 0x30;
1385   1        else if((aChar>=0x41)&&(aChar<=0x46))//capital
1386   1        aChar -= 0x37;
1387   1        else if((aChar>=0x61)&&(aChar<=0x66))//small
1388   1        aChar -= 0x57;
1389   1        else aChar = 0xff;
1390   1        return aChar;
1391   1      }   
1392            
1393          unsigned char IntegrateAscToHex(unsigned char High_aChar,unsigned char Low_aChar)
1394          {
1395   1        unsigned char Hex;
1396   1        Hex = (HexToAsc(High_aChar) << 4) + HexToAsc(Low_aChar);
1397   1        return Hex;
1398   1      } 


